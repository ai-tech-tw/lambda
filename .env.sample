# ==============================================================================
# LINE Messaging API 設定 / LINE Messaging API Credentials
# ==============================================================================
LINE_CHANNEL_ACCESS_TOKEN="your_channel_access_token"
LINE_CHANNEL_SECRET="your_channel_secret"

# ==============================================================================
# 模型供應商設定 / Model Provider Configuration
# 支援 NVIDIA NIM、Nymph 社群免費閘道或官方 OpenAI API
# ==============================================================================

# [選項 A / Option A] NVIDIA NIM (NVIDIA 推論微服務 / NVIDIA Inference Microservices)
# OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
# OPENAI_API_KEY="nvapi-your-nvidia-nim-key"
# OPENAI_CHAT_MODEL="openai/gpt-oss-20b"

# [選項 B / Option B] Nymph 社群免費試用端點 (Web-Tech-TW / AI-Tech-TW)
# OPENAI_BASE_URL="https://web-tech.tw/recv/openai/v1"
# OPENAI_API_KEY="nymph zr3Pjc68z4bOtw=="
# OPENAI_CHAT_MODEL="auto"

# [選項 C / Option C] 官方 OpenAI API / Official OpenAI API
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_CHAT_MODEL="gpt-3.5-turbo"

# ==============================================================================
# 工具與代理設定 / Agent & External Tools Configuration
# ==============================================================================
TAVILY_API_KEY="your_tavily_api_key"
AGENT_TIMEOUT_SECONDS="60"
